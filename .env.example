# Copy this file to `.env` and fill in real values. Source before runserver:
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)
#   python3 manage.py runserver
#
# `.env` itself is gitignored.

# Stripe — get test-mode keys at https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_REPLACE_ME

# Run `stripe listen --forward-to localhost:8000/api/payments/webhook` and copy
# the `whsec_...` value it prints into this var.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Frontend origin — used in Stripe Checkout success/cancel URLs.
# Defaults to http://localhost:5173 if unset; override here if you run Vite elsewhere.
FRONTEND_URL=http://localhost:5173

# --- Reserved for T005 (Twilio WhatsApp delivery) — not yet read by any code ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
